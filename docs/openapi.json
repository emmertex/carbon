{
  "openapi": "3.1.0",
  "info": {
    "title": "Carbon personal-key task API",
    "version": "1.1.0"
  },
  "security": [
    {
      "personalKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "personalKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Personal key, intersected with live owner permissions and selected project subtrees"
      }
    },
    "schemas": {
      "Person": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_bot": {
            "type": "boolean",
            "description": "true for agent users"
          }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "item_id": {
            "type": "string"
          },
          "author": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Person"
              },
              {
                "type": "null"
              }
            ]
          },
          "body": {
            "type": "string",
            "description": "Markdown"
          },
          "mentions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Person"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string"
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/tasks": {
      "get": {
        "responses": {
          "200": {
            "description": "tasks, total, limit, offset, has_more, next_offset; follow next_offset until has_more is false"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired or revoked key"
          },
          "403": {
            "description": "Scope, subtree or current user permission denied"
          },
          "404": {
            "description": "Task not found or inaccessible"
          },
          "413": {
            "description": "Payload or response too large"
          },
          "429": {
            "description": "Quota or concurrency limit; honor Retry-After"
          }
        },
        "description": "Requires tasks:read",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ]
      },
      "post": {
        "responses": {
          "200": {
            "description": "Successful task response"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired or revoked key"
          },
          "403": {
            "description": "Scope, subtree or current user permission denied"
          },
          "404": {
            "description": "Task not found or inaccessible"
          },
          "413": {
            "description": "Payload or response too large"
          },
          "429": {
            "description": "Quota or concurrency limit; honor Retry-After"
          },
          "201": {
            "description": "Created task or comment"
          }
        },
        "description": "Requires inbox:write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "project_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "parent_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "note": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "body": {
                    "type": "string"
                  }
                },
                "required": [
                  "title"
                ]
              }
            }
          }
        }
      }
    },
    "/api/tasks/{id}": {
      "get": {
        "responses": {
          "200": {
            "description": "Successful task response"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired or revoked key"
          },
          "403": {
            "description": "Scope, subtree or current user permission denied"
          },
          "404": {
            "description": "Task not found or inaccessible"
          },
          "413": {
            "description": "Payload or response too large"
          },
          "429": {
            "description": "Quota or concurrency limit; honor Retry-After"
          }
        },
        "description": "Requires tasks:read. ?include= embeds the comment thread, subtasks, assignees and attachments.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "include",
            "schema": {
              "type": "string"
            },
            "description": "Comma list of comments, subtasks, assignees, attachments, or all. Omitted: the task alone."
          }
        ]
      },
      "patch": {
        "responses": {
          "200": {
            "description": "Successful task response"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired or revoked key"
          },
          "403": {
            "description": "Scope, subtree or current user permission denied"
          },
          "404": {
            "description": "Task not found or inaccessible"
          },
          "413": {
            "description": "Payload or response too large"
          },
          "429": {
            "description": "Quota or concurrency limit; honor Retry-After"
          }
        },
        "description": "Requires tasks:write",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "project_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "parent_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "note": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "body": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{id}/complete": {
      "post": {
        "responses": {
          "200": {
            "description": "Successful task response"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired or revoked key"
          },
          "403": {
            "description": "Scope, subtree or current user permission denied"
          },
          "404": {
            "description": "Task not found or inaccessible"
          },
          "413": {
            "description": "Payload or response too large"
          },
          "429": {
            "description": "Quota or concurrency limit; honor Retry-After"
          }
        },
        "description": "Requires tasks:write",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/tasks/{id}/comments": {
      "post": {
        "responses": {
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired or revoked key"
          },
          "403": {
            "description": "Scope, subtree or current user permission denied"
          },
          "404": {
            "description": "Task not found or inaccessible"
          },
          "413": {
            "description": "Payload or response too large"
          },
          "429": {
            "description": "Quota or concurrency limit; honor Retry-After"
          },
          "201": {
            "description": "Comment created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Comment"
                }
              }
            }
          }
        },
        "description": "Requires tasks:write. @username in the body (or mentions) notifies those people by push and runs mentioned agents. An agent may comment only where it is assigned or mentioned.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "body"
                ],
                "properties": {
                  "body": {
                    "type": "string",
                    "maxLength": 20000
                  },
                  "mentions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Usernames or user ids to notify, in addition to @username in the body"
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "description": "Requires tasks:read. The task's comments, oldest first.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "since",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Only comments created after this time"
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired or revoked key"
          },
          "403": {
            "description": "Scope, subtree or current user permission denied"
          },
          "404": {
            "description": "Task not found or inaccessible"
          },
          "413": {
            "description": "Payload or response too large"
          },
          "429": {
            "description": "Quota or concurrency limit; honor Retry-After"
          },
          "200": {
            "description": "Comment thread",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "task_id": {
                      "type": "string"
                    },
                    "comments": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Comment"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{id}/comments/{cid}": {
      "patch": {
        "description": "Requires tasks:write. Edit your own comment; newly @mentioned people are notified.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "cid",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "body"
                ],
                "properties": {
                  "body": {
                    "type": "string",
                    "maxLength": 20000
                  },
                  "mentions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Usernames or user ids to notify, in addition to @username in the body"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired or revoked key"
          },
          "403": {
            "description": "Scope, subtree or current user permission denied"
          },
          "404": {
            "description": "Task not found or inaccessible"
          },
          "413": {
            "description": "Payload or response too large"
          },
          "429": {
            "description": "Quota or concurrency limit; honor Retry-After"
          },
          "200": {
            "description": "Comment updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Comment"
                }
              }
            }
          }
        }
      },
      "delete": {
        "description": "Requires tasks:write. Delete your own comment.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "cid",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired or revoked key"
          },
          "403": {
            "description": "Scope, subtree or current user permission denied"
          },
          "404": {
            "description": "Task not found or inaccessible"
          },
          "413": {
            "description": "Payload or response too large"
          },
          "429": {
            "description": "Quota or concurrency limit; honor Retry-After"
          },
          "200": {
            "description": "Deleted"
          }
        }
      }
    },
    "/api/comments": {
      "get": {
        "description": "Requires tasks:read. Comment activity across every task the key can see, oldest first \u2014 the polling primitive for agents. Pass the returned cursor back as since.",
        "parameters": [
          {
            "in": "query",
            "name": "since",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Only comments created after this time"
          },
          {
            "in": "query",
            "name": "for",
            "schema": {
              "type": "string",
              "enum": [
                "me"
              ]
            },
            "description": "Only comments that @mention me or are on tasks assigned to/owned by me, excluding my own"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 100,
              "maximum": 500
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired or revoked key"
          },
          "403": {
            "description": "Scope, subtree or current user permission denied"
          },
          "404": {
            "description": "Task not found or inaccessible"
          },
          "413": {
            "description": "Payload or response too large"
          },
          "429": {
            "description": "Quota or concurrency limit; honor Retry-After"
          },
          "200": {
            "description": "Comment page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "me": {
                      "$ref": "#/components/schemas/Person"
                    },
                    "comments": {
                      "type": "array",
                      "items": {
                        "allOf": [
                          {
                            "$ref": "#/components/schemas/Comment"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "task": {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": "string"
                                  },
                                  "title": {
                                    "type": "string"
                                  },
                                  "status": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        ]
                      }
                    },
                    "cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "has_more": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
