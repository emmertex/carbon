# Carbon server configuration

# Port the server listens on
PORT=3069

# Path to the SQLite database file
DATABASE_PATH=./data/carbon.db

# Directory of the built web app to serve (set by Docker; for local dev the web
# app runs separately on Vite)
# STATIC_DIR=../web/dist

# Comma-separated user:sha256hash pairs. Generate with:
#   npm run add-user -w @carbon/server -- <username> '<password>'
# Prefer creating accounts with `npm run add-user`. Open mode (no users → unauthenticated
# API) is OFF by default; set ALLOW_OPEN_MODE=1 only for a private LAN-only box.
AUTH_USERS=

# Opt-in: when the default tenant has zero users, expose the API as a synthetic local
# admin with no credentials. Never enable on an internet-facing host. Ignored when
# BASE_DOMAIN is set (multi-tenant hosted).
# ALLOW_OPEN_MODE=1

# Trust the last X-Forwarded-For hop for per-IP rate limits (set when Carbon sits behind
# a reverse proxy that appends the real client address). Default off — uses the TCP peer.
# TRUST_PROXY=1

# Comma-separated CORS allowlist. Default '*' (fine for local/dev). On a hosted
# BASE_DOMAIN deploy, set this to your apex + native-shell origins (see docs/api.md).
# CORS_ORIGINS=https://carbon.example,tauri://localhost,https://localhost

# Max JSON/text body size in KB for public routes (/host/*, Telegram webhook,
# /api/federation/*). Blobs use BLOB_MAX_MB separately. Default 1024 (1 MB).
# JSON_BODY_LIMIT_KB=1024

# Default per-workspace blob storage cap, in MB (host admins can override per
# workspace; 0 = unlimited). The single-tenant self-host DB is always uncapped.
# BLOB_QUOTA_MB=500

# Default max human users per hosted workspace/subscription (host admins can override
# per workspace on the host-admin screen; 0 = unlimited). Bot/agent accounts don't
# count. The single-tenant self-host is always unlimited.
MAX_WORKSPACE_USERS=6

# ----- AI agents & natural-language commands (optional) --------------------
# Carbon can run a configured LLM for the in-app "Add task" box (keyword entries
# like "add milk to my shopping list") and for comment-reply bots. The agent,
# trigger keywords, and token usage are configured in
# Settings → AI agents / Natural-language commands; these env vars tune the
# server-side behaviour.

# Allow agent / LLM / geocoder / webhook endpoints to point at private/LAN/
# loopback hosts (e.g. a local LM Studio on 10.x). Single-tenant self-host already
# allows this; only needed to opt a workspace in under a BASE_DOMAIN. 1 = allow.
# ALLOW_PRIVATE_AGENT_ENDPOINTS=

# Place geocoding for "remind me at <place>" reminders: resolves e.g. "Coles" to
# coordinates and pins them onto the tag's geofence, using the user's latest GPS
# fix as the anchor. Pluggable, OpenStreetMap by default (no API key). Defaults ON
# for single-tenant self-host and OFF under a BASE_DOMAIN — set it explicitly to be
# sure. NOTE: "nearest <place>" also needs a recent GPS fix for the user (from the
# browser's location permission, or Home Assistant POSTing to /api/gps).
CARBON_GEOCODE_ENABLED=1
# Point these at a self-hosted Nominatim / Overpass to avoid the public servers'
# rate limits (recommended beyond light personal use).
# CARBON_NOMINATIM_URL=https://nominatim.openstreetmap.org
# CARBON_OVERPASS_URL=https://overpass-api.de/api/interpreter
# User-Agent sent to the geocoder (Nominatim's usage policy requires one).
# CARBON_GEOCODE_UA=CarbonTasks/1.0 (+https://github.com/; self-hosted task manager)
# Brand-search radius in metres for "nearest <place>".
# CARBON_GEOCODE_RADIUS_M=5000

# Trace each natural-language command to the server log ([nl] lines: text, location
# anchor, geocoder state, every tool call + result, reply). On by default for
# self-host; set to 0 to silence.
# CARBON_NL_DEBUG=1

# LLM sampling for NL commands. Low temperature keeps tool calls deterministic; low
# reasoning effort (GPT-OSS / o-series style models) cuts latency. Set either to "off"
# to omit the parameter. Providers that reject these params are detected automatically
# (one retried request) and the params are skipped for that agent from then on.
# CARBON_NL_TEMPERATURE=0.2
# CARBON_NL_REASONING_EFFORT=low

# ----- Host-shared LM model (optional) --------------------------------------
# Offer ONE OpenAI-compatible model, configured here by the host operator, that any
# workspace can select for NL commands + Telegram (never comment-reply/assignment bots,
# never the NL→filter builder — those still need a workspace's own agent). Shows up as a
# read-only "Host-provided assistant" entry in Settings → AI agents / Natural-language
# commands. Rate-limited per workspace (all three windows independently; blank/0 = unlimited).
HOST_LM_ENABLED=0
# Base URL of the OpenAI-compatible API (scheme optional, defaults to http://). Include
# any path the server needs, e.g. a trailing /v1 for LM Studio.
HOST_LM_IP=
# Bearer token; optional (many local model servers don't require one).
HOST_LM_TOKEN=
# Model name passed to the API.
HOST_LM_MODEL=
# 1 = newly-provisioned workspaces get NL commands pre-enabled with the host model.
HOST_LM_ENABLED_BY_DEFAULT=0
# 1 (default) = newly-provisioned workspaces may select the host model at all. A host
# admin can grant/revoke it per-workspace afterwards regardless of this setting.
HOST_LM_AVAILABLE_NEW_ACCOUNTS=1
# Per-workspace caps on host-model calls; blank/0 = unlimited.
HOST_LM_RATE_LIMIT_PER_MINUTE=
HOST_LM_RATE_LIMIT_PER_6H=
HOST_LM_RATE_LIMIT_PER_WEEK=

# ----- Telegram bot (optional) ---------------------------------------------
# Run ONE Telegram bot for the whole server (not per-workspace). Users link their
# individual Carbon account via a one-time code in Settings → Telegram, then control
# tasks from chat in plain language. The bot reuses the workspace's configured AI
# agent (above), so no extra model setup is needed. See docs/telegram-bot.md.

# Bot token from @BotFather. Setting it enables the bot; leave empty to disable.
TELEGRAM_BOT_TOKEN=
# Public HTTPS base URL of this server. The webhook is registered on startup at
# <TELEGRAM_WEBHOOK_URL>/telegram/webhook. Telegram only delivers webhooks over HTTPS.
TELEGRAM_WEBHOOK_URL=
# Required whenever TELEGRAM_WEBHOOK_URL (or the bot webhook) is enabled. Telegram
# echoes it in a header so Carbon can verify the call is genuine; the webhook route
# fails closed if this is missing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# Optional: the bot's @username, shown in Settings → Telegram (auto-detected otherwise).
# TELEGRAM_BOT_USERNAME=
# Per-chat message cap per hour (a linked chat can fire this many LLM commands/hour).
# TELEGRAM_PER_CHAT_HOUR=120
# Recent messages (user+assistant) kept per chat and replayed as context, so follow-ups like
# "add eggs to it" work. 0 disables conversational memory. Default 6 (~last three exchanges).
# TELEGRAM_HISTORY_MESSAGES=6

# ----- Multi-tenant hosting (optional) -------------------------------------
# Leave BASE_DOMAIN unset for single-tenant self-host (everything = one DB).
#
# Apex domain that turns on subdomain-per-family routing. BARE host only — no
# scheme, no path (http:// is stripped defensively, but keep it clean):
#   BASE_DOMAIN=carbon.etx.sx
# Requires a wildcard DNS record *.carbon.etx.sx and an nginx that forwards the
# Host header (proxy_set_header Host $host) with server_name *.carbon.etx.sx.
BASE_DOMAIN=

# Dedicated offline / local-only host: <APP_HOST>.<BASE_DOMAIN> (default "app").
APP_HOST=app

# Host-admin (cross-tenant operator) accounts — user:sha256hex pairs, same format
# as AUTH_USERS. Generate the hash with:
#   node -e "console.log(require('crypto').createHash('sha256').update('PW').digest('hex'))"
# Only seeded when the host_admins table is empty (clear it to re-seed).
HOST_ADMINS=

# Hold new signups in 'provisional' until a host admin/payment flips them active.
# SIGNUP_REQUIRE_APPROVAL=1

# Days of access a self-service signup gets before the workspace locks (renew gate).
# SIGNUP_TRIAL_DAYS=30
# Per-email cap on /host/signup/start per hour (code-bomb protection).
# SIGNUP_PER_EMAIL_HOUR=3
# Per-IP cap on /host/signup/verify per hour (code brute-force protection).
# VERIFY_PER_IP_HOUR=30
# One-time signup code lifetime (minutes) and max verify attempts before invalidation.
# OTC_TTL_MIN=15
# OTC_MAX_ATTEMPTS=5

# ----- Email / SMTP (for OTC codes + billing receipts) ---------------------
# If unset, emails are logged to the console (dev mode) instead of sent. Proton
# Mail SMTP example:
#   SMTP_HOST=smtp.protonmail.ch
#   SMTP_PORT=587
#   SMTP_USER=you@proton.me
#   SMTP_PASS=<smtp token>
#   SMTP_FROM="Carbon <you@proton.me>"
# SMTP_SECURE defaults to true only on port 465; set 1/0 to override.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_SECURE=

# ----- Square subscriptions (optional) -------------------------------------
# When unset, billing runs a local "simulate" provider (pending→pay→renew→cancel,
# no real charge) so the flow is testable. Set these to enable real auto-renewing
# Square subscriptions (card on file). Use sandbox values while testing.
#   SQUARE_ENV=sandbox            # or "production"
#   SQUARE_ACCESS_TOKEN=...       # sandbox/production access token
#   SQUARE_LOCATION_ID=...        # the location to bill under
#   SQUARE_APP_ID=...             # Web Payments SDK application id (client card form)
#   SQUARE_WEBHOOK_SIGNATURE_KEY=...   # from the webhook subscription
#   SQUARE_WEBHOOK_URL=https://carbon.example/host/billing/webhook  # exact URL (part of HMAC)
# One Square subscription-plan-variation id per plan (create them in the dashboard):
#   SQUARE_PLAN_Q3M=...           # 3-month (quarterly) variation id
#   SQUARE_PLAN_Y1=...            # 1-year (annual) variation id
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_APP_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
SQUARE_PLAN_Q3M=
SQUARE_PLAN_Y1=
