{
  "name": "@carbon/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test --experimental-test-coverage \"src/**/*.test.ts\"",
    "add-user": "tsx scripts/add-user.ts",
    "mfa-admin": "tsx scripts/mfa-admin.ts",
    "backup": "tsx scripts/backup-dbs.ts",
    "reset-sync-epoch": "tsx scripts/reset-sync-epoch.ts"
  },
  "dependencies": {
    "@carbon/core": "*",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.7",
    "nodemailer": "^10.0.1",
    "otpauth": "^9.5.2",
    "undici": "^8.10.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
