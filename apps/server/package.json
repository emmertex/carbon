{
  "name": "@carbon/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test --experimental-test-coverage \"src/**/*.test.ts\"",
    "add-user": "tsx scripts/add-user.ts",
    "backup": "tsx scripts/backup-dbs.ts"
  },
  "dependencies": {
    "@carbon/core": "*",
    "@hono/node-server": "^2.0.8",
    "hono": "^4.12.27",
    "nodemailer": "^9.0.3",
    "undici": "^8.7.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
