{
  "name": "carbon",
  "version": "1.1.3",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:server": "turbo run build --filter=@carbon/server --filter=@carbon/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:persistence": "npm run test:persistence --workspace=@carbon/web",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "perf": "playwright test perf.spec.ts -c perf/playwright.config.ts",
    "perf:smallview": "playwright test smallview.spec.ts -c perf/playwright.config.ts",
    "perf:install": "playwright install chromium",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
