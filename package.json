{
  "name": "carbon",
  "version": "0.1.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:server": "turbo run build --filter=@carbon/server --filter=@carbon/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "perf": "playwright test perf.spec.ts -c perf/playwright.config.ts",
    "perf:smallview": "playwright test smallview.spec.ts -c perf/playwright.config.ts",
    "perf:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "prettier": "^3.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=20"
  }
}
