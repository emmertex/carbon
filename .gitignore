# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
release/
dev-dist/
*.tsbuildinfo

# Editor / agent tooling
.claude/

# Environment (all variants — never commit real env files)
.env
.env.*
!.env.example
!**/.env.example
.env.local
.env.*.local

# Secrets — never commit (server-side Firebase admin key, signing keys, mobile config)
*-firebase-adminsdk-*.json
serviceAccount*.json
*.jks
*.keystore
keystore.properties
google-services.json
# Hermes skill credentials (per-skill .credentials hold API tokens; ship .example only)
hermes/**/.credentials

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database
*.sqlite
*.sqlite3
*.db

# Data volumes (for Docker). Any data/ dir stays ignored, but the *root* one is
# tracked via .gitkeep so a fresh clone already owns it — otherwise Docker creates
# the bind-mount source as root and the unprivileged container can't write to it.
data/
!/data/
/data/*
!/data/.gitkeep

.quasar/
.turbo/
.capacitor/
.next/

node_modules/
dist/
build/
*.tsbuildinfo
docs/internal/

# Playwright benchmark artifacts
test-results/
perf/test-results/
e2e/test-results/
e2e/.tmp/

# Python bytecode (hermes scripts)
__pycache__/
*.pyc
